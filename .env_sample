# Template for local settings. Copy it and edit your copy:
#   cp .env_sample .env
# .env is gitignored - never commit it. Precedence: command-line flags > real environment
# variables > .env > built-in defaults. On Render/Vercel, set these in the dashboard instead.

# --- Supabase (Project Settings -> API Keys in the Supabase dashboard) ---
SUPABASE_URL=
# Publishable key (sb_publishable_...): safe in browsers because every table has Row Level Security.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) bypasses Row Level Security: server-side only (Render, your laptop),
# never in a frontend or a VITE_ variable. Legacy name SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=
# Only needed by code that verifies user JWTs itself.
SUPABASE_JWKS_URL=

# --- Synthea (pnpm data:synthea -> server/Synthea_Gen/synthea.py) ---
SYNTHEA_VERSION=v4.0.0
# Keep the seed fixed so the whole team generates identical patients.
SYNTHEA_SEED=1984
SYNTHEA_POPULATION=25
SYNTHEA_AGES=18-90
SYNTHEA_STATE=Massachusetts
SYNTHEA_CITY=Boston

# --- Vitals simulator (pnpm sim:demo / pnpm sim:serve -> server/sim/cli.py) ---
SIM_SEED=1984
SIM_HOST=127.0.0.1
SIM_PORT=8765
# If set, POST demo controls need `Authorization: Bearer <token>` (Render generates one).
SIM_CONTROL_TOKEN=
# Token the patient app sends with its requests (POST /patient-requests -> `alerts`). Unset = that
# endpoint is off. Use a different value from SIM_CONTROL_TOKEN, and put the same value in each
# patient device's apps/patient-desktop/.env. Make one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PATIENT_REQUEST_TOKEN=

# Frontend (Vite) settings don't go here: see apps/nurse-web/.env.example.
